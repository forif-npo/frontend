# Backend API origin. Do not point this at the local Next.js server.
NEXT_PUBLIC_SERVER_URL=https://dev.forif.org

# Auth.js URL (local development). Set both to the deployed frontend URL in Vercel.
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth / Auth.js
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
AUTH_SECRET=<your_auth_secret>

# Maps
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=<your_kakao_map_javascript_key>
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=<your_naver_map_client_id>
NAVER_MAP_CLIENT_SECRET=<your_naver_map_client_secret>
